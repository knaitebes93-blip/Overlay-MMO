{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/renderer/**/*", "src/components/**/*", "src/builder/**/*", "src/shared/**/*", "src/types/**/*", "src/widgetSpec/**/*", "src/state/**/*"]
}
